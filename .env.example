# Copie para .env e ajuste. Nunca versione o .env.

# --- Servidor ---
PORT=3000
HOST=127.0.0.1
# Pasta do banco SQLite, uploads e segredo de sessão (padrão: ./data)
# DATA_DIR=./data
# Defina como 1 quando servir por HTTPS (cookies com flag Secure)
# COOKIE_SECURE=1
# Segredo para assinar cookies. Se vazio, é gerado e guardado em data/session.key
# SESSION_SECRET=

# --- TMDB (fonte principal) ---
# Crie a chave em https://www.themoviedb.org/settings/api
# Aceita a "API Key" (v3) ou o "API Read Access Token" (v4, começa com eyJ).
TMDB_API_KEY=
# TMDB_READ_TOKEN=

# --- Tape Club Bot (serviço local Python; o Node faz a ponte autenticada) ---
BOT_HOST=127.0.0.1
BOT_PORT=3101
BOT_URL=http://127.0.0.1:3101
# BOT_DB=./data/tape-club-bot.sqlite3

# --- Wikimedia/Wikidata pedem um contato no User-Agent ---
# CONTACT_EMAIL=voce@exemplo.com
